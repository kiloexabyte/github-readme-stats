{
  "name": "github-readme-stats",
  "version": "1.0.0",
  "description": "Dynamically generate stats for your GitHub readme",
  "keywords": [
    "github-readme-stats",
    "readme-stats",
    "cards",
    "card-generator"
  ],
  "main": "src/index.ts",
  "type": "module",
  "homepage": "https://github.com/anuraghazra/github-readme-stats",
  "bugs": {
    "url": "https://github.com/anuraghazra/github-readme-stats/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anuraghazra/github-readme-stats.git"
  },
  "scripts": {
    "test": "bun test --coverage",
    "test:watch": "bun test --watch",
    "test:update:snapshot": "bun test --update-snapshots",
    "test:e2e": "bun test tests/e2e/",
    "typecheck": "bunx tsc --noEmit",
    "dev": "bun server.ts",
    "theme-readme-gen": "bun scripts/generate-theme-doc.ts",
    "preview-theme": "bun scripts/preview-theme.ts",
    "close-stale-theme-prs": "bun scripts/close-stale-theme-prs.ts",
    "generate-langs-json": "bun scripts/generate-langs-json.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "lint": "bunx eslint --max-warnings 0 \"./src/**/*.ts\" \"./scripts/**/*.ts\" \"./tests/**/*.ts\" \"./api/**/*.ts\" \"./themes/**/*.ts\""
  },
  "author": "Anurag Hazra",
  "license": "MIT",
  "devDependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.29.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^25.3.3",
    "@typescript-eslint/parser": "^8.56.1",
    "@uppercod/css-to-object": "^1.1.1",
    "@vercel/node": "^5.6.9",
    "color-contrast-checker": "^2.1.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsdoc": "^50.7.1",
    "globals": "^16.2.0",
    "hjson": "^3.2.2",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "jsdom": "^28.1.0",
    "lint-staged": "^15.5.1",
    "lodash.snakecase": "^4.1.1",
    "parse-diff": "^0.11.1",
    "prettier": "^3.6.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "emoji-name-map": "^1.2.8",
    "github-username-regex": "^1.0.0",
    "upgrade": "^1.1.0",
    "word-wrap": "^1.2.5"
  },
  "lint-staged": {
    "*.{ts,js,css,md}": "prettier --write"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
